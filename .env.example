# ─────────────────────────────────────────────────────────────
# SamvedanaSetu — Backend Environment Variables
# Copy this file to ".env" and fill in your key. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Google Gemini API key (server-side only — never exposed to the browser).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Multimodal model used for text + image analysis.
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
HUGGING_FACE_API_KEY=
HUGGING_FACE_MODEL=Salesforce/blip-image-captioning-base

# Port for the Express server.
PORT=3000
