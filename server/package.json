{
  "name": "samvedanasetu-server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:trim-demo": "node prisma/trim-demo-challenges.js",
    "db:clear-challenges": "node prisma/clear-challenges.js",
    "db:clear-workflow": "node prisma/clear-demo-workflow.js",
    "db:reset": "npx prisma db push --force-reset && node prisma/seed.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "prisma": "^6.10.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "@jest/globals": "^29.7.0"
  }
}
